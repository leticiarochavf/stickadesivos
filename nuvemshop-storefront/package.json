{
	"name": "stick-adesivos-nuvemshop-storefront",
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "concurrently -k -n BUILD,SERVE -c blue,green \"tsup --sourcemap inline --watch\" \"serve dist -l 8080 --cors\"",
		"build": "tsup",
		"test": "vitest run",
		"test:watch": "vitest watch",
		"format": "biome check --write ./src",
		"lint": "biome check ./src"
	},
	"author": "Tiendanube / Nuvemshop",
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@tiendanube/nube-sdk-helper": "^0.3.0",
		"@tiendanube/nube-sdk-jsx": "^0.21.0",
		"@tiendanube/nube-sdk-types": "^0.94.0",
		"@tiendanube/nube-sdk-ui": "^0.22.1",
		"concurrently": "^9.1.2",
		"esbuild": "^0.28.2",
		"serve": "^14.2.4",
		"tsup": "^8.3.0",
		"typescript": "^5.6.2",
		"vitest": "^5.0.0"
	},
	"overrides": {
		"tsup": {
			"esbuild": "^0.28.2"
		}
	}
}
