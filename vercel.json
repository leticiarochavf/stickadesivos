{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/catalogo",
      "destination": "/index.html"
    },
    {
      "source": "/carrinho",
      "destination": "/index.html"
    },
    {
      "source": "/contato",
      "destination": "/index.html"
    },
    {
      "source": "/sobre",
      "destination": "/index.html"
    },
    {
      "source": "/checkout",
      "destination": "/index.html"
    },
    {
      "source": "/produto/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/orcamento",
      "destination": "/index.html"
    },
    {
      "source": "/servicos",
      "destination": "/index.html"
    },
    {
      "source": "/automotivo",
      "destination": "/index.html"
    },
    {
      "source": "/faq",
      "destination": "/index.html"
    },
    {
      "source": "/politicas",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors https://stickadesivos.com.br https://www.stickadesivos.com.br https://stickadesivos.lojavirtualnuvem.com.br"
        }
      ]
    },
    {
      "source": "/nuvemshop/main.min.js",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
